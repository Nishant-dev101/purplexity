```gitignore
# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# Build files
dist/
build/
.next/
out/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Coverage
coverage/

# Cache
.cache/
.parcel-cache/
.vite/

# Uploaded/generated files
uploads/
temp/
tmp/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.idea/

# Local configuration
*.local

# TypeScript
*.tsbuildinfo
```
